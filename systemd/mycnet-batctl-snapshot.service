[Unit]
Description=MycNet: captura de solo lectura de originadores Batman
After=mycnet-batman.service

[Service]
Type=oneshot
User=root
Group=root
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RuntimeDirectory=mycnet
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/run/mycnet
ExecStart=/usr/local/sbin/mycnet-batctl-snapshot.sh
